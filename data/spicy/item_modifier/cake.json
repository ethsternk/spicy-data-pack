{
    "type": "minecraft:filtered",
    "item_filter": {
        "items": "minecraft:cake"
    },
    "on_pass": {
        "type": "minecraft:filtered",
        "item_filter": {
            "predicates": {
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        },
        "on_fail": {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:lore": [
                    {
                        "text": "🎂 Sugar Rush (1:00)",
                        "color": "#37cafb",
                        "italic": false
                    }
                ],
                "minecraft:max_stack_size": 64,
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        }
    }
}