{
    "type": "minecraft:filtered",
    "item_filter": {
        "items": "minecraft:beetroot_soup"
    },
    "on_pass": {
        "type": "minecraft:filtered",
        "item_filter": {
            "predicates": {
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        },
        "on_fail": {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:lore": [
                    {
                        "text": "🗡 Strength (1:30)",
                        "color": "#e65f33",
                        "italic": false
                    }
                ],
                "minecraft:consumable": {
                    "on_consume_effects": [
                        {
                            "type": "minecraft:apply_effects",
                            "effects": [
                                {
                                    "id": "minecraft:strength",
                                    "duration": 1800,
                                    "show_particles": false,
                                    "show_icon": true
                                }
                            ]
                        }
                    ]
                },
                "minecraft:food": {
                    "nutrition": 6,
                    "saturation": 7.2,
                    "can_always_eat": true
                },
                "minecraft:max_stack_size": 64,
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        }
    }
}