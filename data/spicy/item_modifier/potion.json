{
    "type": "minecraft:filtered",
    "item_filter": {
        "items": "minecraft:potion"
    },
    "on_pass": {
        "type": "minecraft:filtered",
        "item_filter": {
            "predicates": {
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        },
        "on_fail": {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:max_stack_size": 64,
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        }
    }
}