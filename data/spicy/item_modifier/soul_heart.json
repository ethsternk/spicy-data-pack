{
    "type": "minecraft:filtered",
    "item_filter": {
        "items": "#spicy:soul_heart"
    },
    "on_pass": {
        "type": "minecraft:filtered",
        "item_filter": {
            "predicates": {
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        },
        "on_fail": {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:lore": [
                    {
                        "text": "Soul Heart (Consumable)",
                        "color": "#538481",
                        "italic": true
                    }
                ],
                "minecraft:food": {
                    "nutrition": 20,
                    "saturation": 20,
                    "can_always_eat": true
                },
                "minecraft:consumable": {
                    "consume_seconds": 2,
                    "animation": "eat",
                    "sound": "minecraft:block.amethyst_block.hit",
                    "has_consume_particles": true
                },
                "minecraft:max_stack_size": 64,
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        }
    }
}