{
    "type": "minecraft:filtered",
    "item_filter": {
        "items": "minecraft:bread"
    },
    "on_pass": {
        "type": "minecraft:filtered",
        "item_filter": {
            "predicates": {
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        },
        "on_fail": {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:lore": [
                    {
                        "text": "✨ Purify",
                        "color": "gray",
                        "italic": false
                    }
                ],
                "minecraft:consumable": {
                    "on_consume_effects": [
                        {
                            "type": "minecraft:remove_effects",
                            "effects": [
                                "minecraft:poison",
                                "minecraft:mining_fatigue",
                                "minecraft:wither",
                                "minecraft:weakness",
                                "minecraft:bad_omen",
                                "minecraft:blindness",
                                "minecraft:darkness",
                                "minecraft:infested",
                                "minecraft:weaving",
                                "minecraft:nausea",
                                "minecraft:oozing",
                                "minecraft:slowness"
                            ]
                        }
                    ]
                },
                "minecraft:food": {
                    "nutrition": 5,
                    "saturation": 6,
                    "can_always_eat": true
                },
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        }
    }
}