{
    "type": "minecraft:filtered",
    "item_filter": {
        "items": "minecraft:sweet_berries"
    },
    "on_pass": {
        "type": "minecraft:filtered",
        "item_filter": {
            "predicates": {
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        },
        "on_fail": {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:lore": [
                    {
                        "text": "💕 Health Boost (2:00)",
                        "color": "#ff7f7f",
                        "italic": false
                    }
                ],
                "minecraft:consumable": {
                    "on_consume_effects": [
                        {
                            "type": "minecraft:apply_effects",
                            "effects": [
                                {
                                    "id": "minecraft:health_boost",
                                    "duration": 2400,
                                    "show_particles": false,
                                    "show_icon": true
                                }
                            ]
                        }
                    ]
                },
                "minecraft:food": {
                    "nutrition": 2,
                    "saturation": 0.4,
                    "can_always_eat": true
                },
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        }
    }
}