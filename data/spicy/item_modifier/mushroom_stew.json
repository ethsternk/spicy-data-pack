{
    "type": "minecraft:filtered",
    "item_filter": {
        "items": "minecraft:mushroom_stew"
    },
    "on_pass": {
        "type": "minecraft:filtered",
        "item_filter": {
            "predicates": {
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        },
        "on_fail": {
            "type": "minecraft:set_components",
            "components": {
                "minecraft:lore": [
                    {
                        "text": "🏃 Speed (1:00)",
                        "color": "#37cafb",
                        "italic": false
                    },
                    {
                        "text": "➕ Instant Health II",
                        "color": "red",
                        "italic": false
                    }
                ],
                "minecraft:consumable": {
                    "on_consume_effects": [
                        {
                            "type": "minecraft:apply_effects",
                            "effects": [
                                {
                                    "id": "minecraft:speed",
                                    "duration": 1200,
                                    "show_particles": false,
                                    "show_icon": true
                                },
                                {
                                    "id": "minecraft:instant_health",
                                    "amplifier": 1,
                                    "duration": 1,
                                    "show_particles": false
                                }
                            ]
                        }
                    ]
                },
                "minecraft:food": {
                    "nutrition": 6,
                    "saturation": 7.2,
                    "can_always_eat": true
                },
                "minecraft:max_stack_size": 64,
                "minecraft:custom_data": {
                    "spicy_version": "v1"
                }
            }
        }
    }
}